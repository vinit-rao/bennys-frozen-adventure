using System.Collections;
using System.Collections.Generic;
using UnityEngine;

public class StarRating : MonoBehaviour
{
    // Start is called before the first frame update
    void Start()
    {
        int stars = 0;

        if (UnityEngine.SceneManagement.SceneManager.GetActiveScene().name == "WinMenu1" ||
            UnityEngine.SceneManagement.SceneManager.GetActiveScene().name == "LoseMenu1")
        {
            stars = PlayerPrefs.GetInt("L1Stars", 0);
        }
        else if (UnityEngine.SceneManagement.SceneManager.GetActiveScene().name == "WinMenu2" ||
                 UnityEngine.SceneManagement.SceneManager.GetActiveScene().name == "LoseMenu2")
        {
            stars = PlayerPrefs.GetInt("L2Stars", 0);
        }
        else if (UnityEngine.SceneManagement.SceneManager.GetActiveScene().name == "WinMenu3" ||
                 UnityEngine.SceneManagement.SceneManager.GetActiveScene().name == "LoseMenu3")
        {
            stars = PlayerPrefs.GetInt("L3Stars", 0);
        }

        switch (stars) {

            case 1:
                break;
            case 2:
                break;
                Destroy(gameObject.transform.Find("star3"));
                Destroy(gameObject.transform.Find("star5"));
            case 3:
                break;
                Destroy(gameObject.transform.Find("star4"));
                Destroy(gameObject.transform.Find("star5"));
            case 4:
                break;
                Destroy(gameObject.transform.Find("star5"));
        }
            
    }
}
